// GPS LoRa Tracker mit Kalibrierung, UI, RSSI, BLE Backup & BLE Beacon + BLE-Richtungsschätzung


#include <TFT_eSPI.h>
#include <SPI.h>
#include <LoRa.h>
#include <TinyGPS++.h>
#include <HardwareSerial.h>
#include <QMC5883LCompass.h>
#include <Wire.h>
#include <Preferences.h>
#include <math.h>
#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEScan.h>
#include <BLEServer.h>

#define LORA_SCK   12
#define LORA_MISO  35
#define LORA_MOSI  32
#define LORA_CS    13
#define LORA_RST   14
#define LORA_DIO0  2

#define GPS_RX     16
#define GPS_TX     17

TFT_eSPI tft = TFT_eSPI();
TinyGPSPlus gps;
HardwareSerial gpsSerial(1);
QMC5883LCompass compass;
Preferences prefs;
BLEScan* bleScanner;
BLEAdvertising* bleAdvertising;

const String myName = "Bravo"; //Namen ändern
const String expectedOtherName = "Alpha"; // gegen Partner Namen ändern

float myLat = 0.0, myLng = 0.0;
float otherLat = 0.0, otherLng = 0.0;
float myHeading = 0.0, targetHeading = 0.0, distance = -1.0;
float bleHeadingGuess = -1.0;
String otherName = "Alpha";
int lastRSSI = 0;
int lastBLERSSI = -100;
float strongestBLEHeading = -1.0;
int strongestBLERSSI = -120;

int xOffset = 0, yOffset = 0;
unsigned long lastSend = 0, lastUpdate = 0;

float toRadians(float deg) { return deg * PI / 180.0; }

float calculateDistance(float lat1, float lon1, float lat2, float lon2) {
  float R = 6371.0;
  float dLat = toRadians(lat2 - lat1);
  float dLon = toRadians(lon2 - lon1);
  lat1 = toRadians(lat1);
  lat2 = toRadians(lat2);
  float a = sin(dLat/2)*sin(dLat/2) + cos(lat1)*cos(lat2)*sin(dLon/2)*sin(dLon/2);
  float c = 2 * atan2(sqrt(a), sqrt(1-a));
  return R * c;
}

float calculateBearing(float lat1, float lon1, float lat2, float lon2) {
  float dLon = toRadians(lon2 - lon1);
  lat1 = toRadians(lat1);
  lat2 = toRadians(lat2);
  float y = sin(dLon) * cos(lat2);
  float x = cos(lat1)*sin(lat2) - sin(lat1)*cos(lat2)*cos(dLon);
  return fmod((atan2(y, x) * 180.0 / PI + 360.0), 360.0);
}

void drawArrow(float angle, uint16_t color) {
  int cx = tft.width() / 2;
  int cy = tft.height() / 2;
  float rad = toRadians(angle);
  int x1 = cx + cos(rad) * 50;
  int y1 = cy + sin(rad) * 50;
  int x2 = cx + cos(rad + PI * 0.8) * 20;
  int y2 = cy + sin(rad + PI * 0.8) * 20;
  int x3 = cx + cos(rad - PI * 0.8) * 20;
  int y3 = cy + sin(rad - PI * 0.8) * 20;
  tft.fillTriangle(x1, y1, x2, y2, x3, y3, color);
}

String formatDistance(float distKm) {
  if (distKm < 0.001) return String(distKm * 100000.0, 0) + " cm";
  else if (distKm < 1.0) return String(distKm * 1000.0, 1) + " m";
  else return String(distKm, 2) + " km";
}

uint16_t getColorForDistance(float distKm) {
  if (distKm < 0.01) return TFT_GREEN;
  else if (distKm < 0.1) return TFT_YELLOW;
  else if (distKm < 1.0) return TFT_ORANGE;
  else return TFT_RED;
}

int rssiToPercent(int rssi) {
  int percent = map(rssi, -100, -40, 0, 100);
  if (percent > 100) percent = 100;
  if (percent < 0) percent = 0;
  return percent;
}

class MyBLECallbacks : public BLEAdvertisedDeviceCallbacks {
  void onResult(BLEAdvertisedDevice advertisedDevice) override {
    if (advertisedDevice.haveName() && String(advertisedDevice.getName().c_str()) == expectedOtherName) {
      lastBLERSSI = advertisedDevice.getRSSI();
      if (lastBLERSSI > strongestBLERSSI) {
        strongestBLERSSI = lastBLERSSI;
        strongestBLEHeading = myHeading;
      }
    }
  }
};

void setup() {
  Serial.begin(115200);
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);
  tft.setTextDatum(MC_DATUM);
  tft.setTextSize(2);

  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX, GPS_TX);
  SPI.begin(LORA_SCK, LORA_MISO, LORA_MOSI, LORA_CS);
  LoRa.setPins(LORA_CS, LORA_RST, LORA_DIO0);
  LoRa.begin(433E6);

  Wire.begin(19, 21);
  compass.init();

  prefs.begin("tracker", false);
  xOffset = prefs.getInt("xOffset", 0);
  yOffset = prefs.getInt("yOffset", 0);

  BLEDevice::init(myName.c_str());
  BLEDevice::createServer();
  bleAdvertising = BLEDevice::getAdvertising();
  bleAdvertising->setScanResponse(false);
  bleAdvertising->setMinPreferred(0x06);
  bleAdvertising->setMinPreferred(0x12);
  bleAdvertising->start();

  bleScanner = BLEDevice::getScan();
  bleScanner->setAdvertisedDeviceCallbacks(new MyBLECallbacks());
  bleScanner->setActiveScan(true);
}

void loop() {
  while (gpsSerial.available()) gps.encode(gpsSerial.read());
  if (gps.location.isUpdated()) {
    myLat = gps.location.lat();
    myLng = gps.location.lng();
    String msg = myName + "," + String(myLat, 6) + "," + String(myLng, 6);
    LoRa.beginPacket();
    LoRa.print(msg);
    LoRa.endPacket();
  }

  compass.read();
  int x = compass.getX();
  int y = compass.getY();
  myHeading = atan2((float)(y - yOffset), (float)(x - xOffset)) * 180.0 / PI;
  if (myHeading < 0) myHeading += 360.0;

  bleScanner->start(1, false);

  int size = LoRa.parsePacket();
  if (size) {
    String incoming = "";
    while (LoRa.available()) incoming += (char)LoRa.read();
    lastRSSI = LoRa.packetRssi();
    int firstComma = incoming.indexOf(',');
    int secondComma = incoming.indexOf(',', firstComma + 1);
    if (firstComma != -1 && secondComma != -1) {
      otherName = incoming.substring(0, firstComma);
      if (otherName == expectedOtherName) {
        otherLat = incoming.substring(firstComma + 1, secondComma).toFloat();
        otherLng = incoming.substring(secondComma + 1).toFloat();
        distance = calculateDistance(myLat, myLng, otherLat, otherLng);
        targetHeading = calculateBearing(myLat, myLng, otherLat, otherLng);
      }
    } else {
      distance = -1.0;
    }
  }

  if (millis() - lastUpdate > 1000) {
    lastUpdate = millis();
    tft.fillScreen(TFT_BLACK);
    tft.setTextSize(2);

    if (distance >= 0) {
      uint16_t arrowColor = getColorForDistance(distance);
      drawArrow(targetHeading - myHeading, arrowColor);
      tft.drawString("Distanz:", 120, 20);
      tft.drawString(formatDistance(distance), 120, 50);
      int signalPercent = rssiToPercent(lastRSSI);
      tft.drawString(String(signalPercent) + "% Signal", 120, 80);
      tft.setTextColor(arrowColor);
      tft.drawString("Richtung", 120, 110);
      tft.setTextColor(TFT_WHITE);
      tft.fillCircle(30, 30, 10, arrowColor);
    } else {
      tft.drawString("Kein GPS", 120, 20);
      tft.drawString("LoRa RSSI: " + String(rssiToPercent(lastRSSI)) + "%", 120, 50);
      tft.drawString("BLE RSSI: " + String(rssiToPercent(lastBLERSSI)) + "%", 120, 70);
      uint16_t color = lastBLERSSI > -70 ? TFT_GREEN : (lastBLERSSI > -90 ? TFT_YELLOW : TFT_RED);
      if (strongestBLEHeading >= 0) {
        drawArrow(strongestBLEHeading - myHeading, color);
        tft.drawString("BLE Richtung", 120, 110);
      }
      tft.fillCircle(30, 30, 10, color);
    }

    tft.setTextSize(1);
    tft.drawString("Ich: " + String(myLat, 4) + "," + String(myLng, 4), 120, 200);
    tft.drawString("Ziel: " + otherName, 120, 215);
    tft.drawString(String(otherLat, 4) + "," + String(otherLng, 4), 120, 230);
  }
}
